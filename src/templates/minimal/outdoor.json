          "montserrat-light"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          1,
          12,
          5,
          16
        ],
        "text-padding": 5,
        "text-max-width": 9,
        "text-letter-spacing": 0.015
      },
      "paint": {
        "text-color": "#6e6e73",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
