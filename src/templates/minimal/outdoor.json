      "source": "osm",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.3,
          15,
          2.8,
          18,
          12
        ]
      },
      "minzoom": 11,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "secondary",
            "tertiary",
            "minor"
          ]
        ]
      ]
    },
    {
      "id": "major",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f3ead7",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.3,
          12,
          1.8,
          16,
          8,
          18,
          20
        ]
      },
      "minzoom": 6,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary"
          ]
        ]
      ]
    },
    {
      "id": "railway",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c9c7c2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          18,
          2
        ],
        "line-dasharray": [
          2,
          2
        ]
      },
      "minzoom": 13,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "rail"
          ]
        ]
      ]
    },
    {
      "id": "street-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "montserrat-light"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          11,
          18,
          13
        ],
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-padding": 6
      },
      "paint": {
        "text-color": "#6e6e73",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "minzoom": 14
    },
