            "zoom"
          ],
          11,
          0.5,
          15,
          4,
          18,
          14
        ]
      },
      "minzoom": 11,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "secondary",
            "tertiary",
            "minor"
          ]
        ]
      ]
    },
