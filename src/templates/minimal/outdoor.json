          12,
          3,
          16,
          10,
          18,
          22
        ]
      },
      "minzoom": 6,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary"
          ]
        ]
      ]
    },
    {
      "id": "service",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.3,
          18,
          3.5
        ]
      },
      "minzoom": 15,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "service",
            "track",
            "path"
          ]
        ]
      ]
    },
    {
      "id": "minor",
