{
  "version": 8,
  "name": "Minimal",
  "metadata": {
    "map-stylizer:template": "minimal",
    "map-stylizer:version": 1,
    "map-stylizer:provider": "mappedin"
  },
  "glyphs": "https://tile-server.mappedin.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://tile-server.mappedin.com/data/osm.json",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f9f5ed"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#f6f5f1"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e3ecdf"
      },
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "park",
            "cemetery",
            "recreation_ground"
          ]
        ]
      ]
    },
    {
      "id": "natural",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e3ecdf"
      },
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "wood",
            "grass",
            "public_park"
          ]
        ]
      ]
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#cfe4ee"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#cfe4ee",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          16,
          3
        ]
      },
      "minzoom": 8
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d8d4cd",
        "line-width": 0.6,
        "line-dasharray": [
          3,
          3
        ],
        "line-opacity": 0.7
      },
      "maxzoom": 13
    },
    {
      "id": "building",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "paint": {
        "fill-color": "#e9e6e0",
        "fill-outline-color": "#d8d4cd",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0,
          15,
          1
        ]
      },
      "minzoom": 14
    },
    {
      "id": "service-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#deddd8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.5,
          18,
          5
        ]
      },
      "minzoom": 15,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "service",
            "track",
            "path"
          ]
        ]
      ]
    },
    {
      "id": "minor-casing",
