      "paint": {
        "text-color": "#456b7b",
        "text-halo-color": "#cfe4ee",
        "text-halo-width": 1
      },
      "minzoom": 9
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "montserrat-light"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          12,
          12,
          15
        ],
        "text-padding": 5,
        "text-max-width": 9,
        "text-letter-spacing": 0.015
      },
      "paint": {
        "text-color": "#6e6e73",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "minzoom": 5,
      "filter": [
        "in",
        [
          "get",
          "class"
